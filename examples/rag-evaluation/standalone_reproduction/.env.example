# ollama：推荐的本地真实语义检索与生成方案
# openai_compatible：使用兼容 /embeddings 和 /chat/completions 的服务
# deterministic：离线测试替身，使用时必须设置 EMBEDDING_DIMENSIONS=384
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_API_KEY=

EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
# Qwen3 Embedding 的查询侧任务指令，留空即可关闭
EMBEDDING_QUERY_INSTRUCTION=Given a user question, retrieve relevant passages from the knowledge base that answer the question
CHAT_MODEL=qwen3:4b-instruct

KNOWLEDGE_BASE_NAME=7.5 RAG 评测测试数据集
CHUNK_SIZE=1000
CHUNK_OVERLAP=80
TOP_K=4
MIN_RELEVANCE_SCORE=0.35
MAX_UPLOAD_MB=8
MODEL_TIMEOUT_SECONDS=120

# SQLite 只保存期望语料、Generation、Job、Manifest 和事件等控制面数据。
# 正文切片、Dense/BM25 向量与所有检索只在 Milvus 中。
CATALOG_PATH=data/rag_studio_production.sqlite3
UPLOAD_DIR=data/uploads

MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
# 查询始终访问 Alias；每次构建会创建带版本号的不可变物理 Collection。
MILVUS_COLLECTION=rag_studio_production_active
MILVUS_COLLECTION_PREFIX=rag_studio_production_v
MILVUS_TIMEOUT_SECONDS=10
MILVUS_WRITE_BATCH_SIZE=64
INDEX_SCHEMA_VERSION=production-rag-v3

# dense：只执行稠密向量检索
# hybrid：Milvus Dense + BM25 两路召回，再用 RRF 融合
# hybrid_rerank：混合召回后再执行真实或降级 Rerank
RETRIEVAL_MODE=hybrid_rerank
DENSE_CANDIDATE_K=20
KEYWORD_CANDIDATE_K=20
RERANK_CANDIDATE_K=20
RRF_K=60

# qwen_api 会调用兼容 /reranks 的真实重排服务；未配置 Key 时明确降级并保留 Hybrid + RRF 排名
RERANK_PROVIDER=qwen_api
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank
RERANK_INSTRUCTION=Given a user question, rank passages by how well they contain the facts needed to answer it.
RERANK_TIMEOUT_SECONDS=60
RERANK_MIN_SCORE=0.15

# 进入 Prompt 前，每条证据最多保留的字符数
CONTEXT_CHUNK_MAX_CHARS=900

# 固定评测集的发布门禁。候选版本不达标时不会移动 Milvus Alias。
QUALITY_RECALL_AT_K_MIN=1.0
QUALITY_MRR_MIN=0.75
QUALITY_NDCG_AT_K_MIN=0.75
QUALITY_NEGATIVE_REJECTION_MIN=1.0
QUALITY_REGRESSION_TOLERANCE=0.02
RELEASE_TOP_K=4

# 有限补证据工作流的硬预算，不允许无限循环检索。
INVESTIGATION_MAX_ROUNDS=2
INVESTIGATION_MAX_QUERIES=3

# RAGAS 生成质量评测。默认关闭，避免没有 Judge 时影响确定性发布门禁。
# 完整评测会调用当前 Serving Alias 的真实 ask() 链路，再把回答和证据交给 Judge。
RAGAS_ENABLED=false
RAGAS_EVALUATION_SET=eval_cases/held_out_v1.jsonl

# OpenAI-compatible Judge。留空时分别复用 MODEL_BASE_URL、MODEL_API_KEY 和 CHAT_MODEL。
# Ollama 用户把 Base URL 写成 http://127.0.0.1:11434/v1，API Key 可以填写 ollama。
RAGAS_JUDGE_BASE_URL=
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_MODEL=
RAGAS_PROMPT_VERSION=ragas-0.4.3-default
RAGAS_INPUT_LANGUAGE=zh-CN
RAGAS_ANSWER_RELEVANCY_STRICTNESS=1
RAGAS_TIMEOUT_SECONDS=180
RAGAS_JUDGE_MAX_TOKENS=8192

# 课程初始门槛。正式项目要用人工标注的中文好坏样本重新校准。
RAGAS_CONTEXT_PRECISION_MIN=0.80
RAGAS_CONTEXT_RECALL_MIN=0.85
RAGAS_FAITHFULNESS_MIN=0.90
RAGAS_ANSWER_RELEVANCY_MIN=0.75
